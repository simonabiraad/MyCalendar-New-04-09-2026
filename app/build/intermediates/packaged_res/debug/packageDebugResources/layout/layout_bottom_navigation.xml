<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/buttonContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_6sdp"
    android:orientation="horizontal"
    android:background="#000000">

    <Button
        android:id="@+id/navHomeButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:text="@string/menu_home"
        android:textColor="@color/light_green"
        android:textSize="@dimen/_9ssp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_menu_home_color"
        app:iconGravity="top"
        app:iconSize="24dp"
        app:iconTint="@null"
        app:elevation="0dp" />

    <Button
        android:id="@+id/navEventButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:text="@string/save_note"
        android:textColor="@color/light_green"
        android:textSize="@dimen/_9ssp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_menu_calendar_color"
        app:iconGravity="top"
        app:iconSize="24dp"
        app:iconTint="@null"
        app:elevation="0dp" />

    <Button
        android:id="@+id/navTaskButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:text="@string/task"
        android:textColor="@color/light_green"
        android:textSize="@dimen/_9ssp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_menu_task_color"
        app:iconGravity="top"
        app:iconSize="24dp"
        app:iconTint="@null"
        app:elevation="0dp" />

    <Button
        android:id="@+id/navSecureBoxButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:text="@string/secure_box"
        android:textColor="@color/light_green"
        android:textSize="@dimen/_9ssp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_menu_accounts_color"
        app:iconGravity="top"
        app:iconSize="24dp"
        app:iconTint="@null"
        app:elevation="0dp" />

    <Button
        android:id="@+id/navExpensesButton"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:text="@string/expenses"
        android:textColor="@color/light_green"
        android:textSize="@dimen/_9ssp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_menu_cash_in_color"
        app:iconGravity="top"
        app:iconSize="24dp"
        app:iconTint="@null"
        app:elevation="0dp" />

</LinearLayout>
