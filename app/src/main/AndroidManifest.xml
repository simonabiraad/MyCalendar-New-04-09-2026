<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyCalendar2026SAR"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SecureBoxActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".CategoryActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ExpensesActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".IncomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ExpenseTypeActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".TransferActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".AccountSummaryActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".TransactionNamesActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".SummaryActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ReportAllActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".DeletedTransactionsActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ExpensesSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".NotebookActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".ImageEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />
        <activity
            android:name=".TaskActivity"
            android:exported="false"
            android:theme="@style/Theme.MyCalendar2026SAR" />

        <service
            android:name=".QuickNoteNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent UI for quick note taking" />
        </service>

        <receiver android:name=".ReminderReceiver" android:exported="false" />

        <!-- Modern Widget System -->
        <receiver android:name=".TodayWidgets$Small" android:exported="false" android:label="Today Summary (Small)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_small_info" />
        </receiver>
        <receiver android:name=".TodayWidgets$Medium" android:exported="false" android:label="Today Notes (Medium)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_medium_info" />
        </receiver>
        <receiver android:name=".TodayWidgets$Large" android:exported="false" android:label="Today Notes (Large)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_large_info" />
        </receiver>

        <receiver android:name=".StickyWidgets$Small" android:exported="false" android:label="Sticky Summary (Small)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sticky_widget_small_info" />
        </receiver>
        <receiver android:name=".StickyWidgets$Medium" android:exported="false" android:label="Sticky Notes (Medium)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sticky_widget_medium_info" />
        </receiver>
        <receiver android:name=".StickyWidgets$Large" android:exported="false" android:label="Sticky Notes (Large)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sticky_widget_large_info" />
        </receiver>

        <receiver android:name=".TaskWidgets$Small" android:exported="false" android:label="Tasks Summary (Small)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/task_widget_small_info" />
        </receiver>
        <receiver android:name=".TaskWidgets$Medium" android:exported="false" android:label="Tasks List (Medium)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/task_widget_medium_info" />
        </receiver>
        <receiver android:name=".TaskWidgets$Large" android:exported="false" android:label="Tasks List (Large)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/task_widget_large_info" />
        </receiver>

        <service android:name=".WidgetListService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />

        <receiver
            android:name=".CalendarWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>